@using Sekolah.DTO
@model PangkatDto
<form id="genericForm" asp-action="CreatePangkatModal" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="GolonganID" />
    <div class="modal-header">
        <h5 class="modal-title fw-bold">Tambah Pangkat</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label small fw-semibold">Golongan Induk</label>
            <input type="text" class="form-control" value="@Model.NamaGolongan" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label small fw-semibold">Kode Pangkat</label>
            <input asp-for="Code" class="form-control" placeholder="Contoh: IV/e" />
        </div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label small fw-semibold">Nama Pangkat</label>
            <input asp-for="Name" class="form-control" placeholder="Contoh: Pembina Utama" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-primary btn-sm px-4">Simpan</button>
    </div>
</form>