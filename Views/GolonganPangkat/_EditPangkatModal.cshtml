@using Sekolah.DTO
@model PangkatDto

<div class="modal-header bg-warning text-dark">
    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Edit Pangkat</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form id="genericForm" asp-action="EditPangkat" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="GolonganID" />

    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label fw-semibold">Golongan Induk</label>
            <input class="form-control" value="@Model.NamaGolongan" readonly disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label fw-semibold">Kode Pangkat</label>
            <input asp-for="Code" class="form-control" placeholder="Contoh: IV/a" required />
        </div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold">Nama Pangkat</label>
            <input asp-for="Name" class="form-control" placeholder="Contoh: Pembina Utama Muda" required />
        </div>
    </div>
    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-save me-1"></i>Simpan Perubahan</button>
    </div>
</form>