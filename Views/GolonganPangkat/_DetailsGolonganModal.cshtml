@using Sekolah.DTO
@model GolonganDto

<div class="modal-header bg-info text-white">
    <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>Detail Golongan</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">Kode Golongan</dt>
        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Code</span></dd>

        <dt class="col-sm-4">Nama Golongan</dt>
        <dd class="col-sm-8 fw-bold">@Model.Nama</dd>

        <dt class="col-sm-4">Jumlah Pangkat</dt>
        <dd class="col-sm-8">@Model.Pangkats.Count Pangkat</dd>
    </dl>
</div>
<div class="modal-footer bg-light">
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Tutup</button>
</div>
