                    @using Microsoft.AspNetCore.Identity
@using Sekolah.Models
@using Sekolah.Models
                    @inject SignInManager<ApplicationUser> SignInManager
                    @inject UserManager<ApplicationUser> UserManager
                    
                    <!-- Menu Kanan Berdasarkan Status Login & Role -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var appUser = await UserManager.GetUserAsync(User);
                            IList<string> roles = await UserManager.GetRolesAsync(appUser);

                            @if (User.IsInRole("admin"))
                            {
                                <!-- Dropdown Khusus ADMIN -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @(appUser?.FirstName + " " + appUser?.LastName + " (Admin)")
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam me-1"></i> Products</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminOrders" asp-action="Index"><i class="bi bi-bag-check me-1"></i> Orders</a></li>
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-1"></i> Users</a></li>
                                        <li><a class="dropdown-item" href="javascript:void(0);" onclick="openGlobalProfileModal()"><i class="bi bi-person me-1"></i> Profile</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-1"></i> Logout</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("CLIENT"))
                            {
                                <!-- Dropdown Khusus CLIENT -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="clientDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @(appUser?.FirstName + " " + appUser?.LastName + " (Client)")
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="clientDropdown">
                                        <li><a class="dropdown-item" asp-controller="ClientOrders" asp-action="Index"><i class="bi bi-bag me-1"></i> Orders</a></li>
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-1"></i> Profile</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-1"></i> Logout</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <!-- Jika user login tapi tidak masuk role Admin/Client -->
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
