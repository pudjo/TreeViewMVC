    <!-- Shell Modal Register Global -->
    <div class="modal fade" id="globalRegisterModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
            <div class="modal-content" id="globalRegisterModalContent">
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Script Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Script Modal Register Global -->
    <script>
        // 1. Fungsi Buka Modal
                        function openRegisterModal(isAdmin) {
            // Kirim parameter ?fromAdmin=true/false ke backend
            $.get('/Account/RegisterPartial', { fromAdmin: isAdmin }, function (data) {
                $('#globalRegisterModalContent').html(data);

                if ($.validator && $.validator.unobtrusive) {
                    $.validator.unobtrusive.parse('#formRegisterModal');
                }

                var modal = new bootstrap.Modal(document.getElementById('globalRegisterModal'));
                modal.show();
            }).fail(function () {
                alert('Gagal memuat form pendaftaran.');
            });
        }

        function submitRegisterModal(event) {
            event.preventDefault(); // Mencegah form reload bawaan

            var $form = $('#formRegisterModal');

            // Ambil data form beserta token AntiForgery
            var formData = $form.serialize();

            $.ajax({
                type: 'POST',
                url: '/Account/Register',
                data: formData,
                headers: {
                    // Memastikan header AntiForgery terisi jika dibutuhkan
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]', $form).val()
                },
                success: function (response) {
                    // Jika backend mengembalikan JSON success
                    if (typeof response === 'object' && response.success) {
                        var modalElement = document.getElementById('globalRegisterModal');
                        var modal = bootstrap.Modal.getInstance(modalElement);
                        if (modal) modal.hide();

                        // Redirect ke Home/Index
                        window.location.href = response.redirectUrl;
                    } else {
                        // Jika ada error validasi/identity, render ulang isi modal
                        $('#globalRegisterModalContent').html(response);

                        if ($.validator && $.validator.unobtrusive) {
                            $.validator.unobtrusive.parse('#formRegisterModal');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Submit Error (Status ' + xhr.status + '):', error);

                    if (xhr.status === 400) {
                        alert('Token validasi kadaluarsa atau data tidak valid. Silakan coba muat ulang modal.');
                    } else {
                        alert('Terjadi kesalahan sistem (' + xhr.status + ').');
                    }
                }
            });
        }
                function openGlobalLoginModal() {
            $.get('/Account/LoginPartial', function (data) {
                $('#globalLoginModalContent').html(data);

                if ($.validator && $.validator.unobtrusive) {
                    $.validator.unobtrusive.parse('#formLoginModal');
                }

                var loginModal = new bootstrap.Modal(document.getElementById('globalLoginModal'));
                loginModal.show();
            }).fail(function () {
                alert('Gagal memuat form login.');
            });
        }

        // 2. Fungsi untuk submit form login via AJAX
        function submitLoginModal(event) {
            event.preventDefault();

            var $form = $('#formLoginModal');
            var formData = $form.serialize();

            $.ajax({
                type: 'POST',
                url: '/Account/Login',
                data: formData,
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]', $form).val()
                },
                success: function (response) {
                    if (typeof response === 'object' && response.success) {
                        var modalElement = document.getElementById('globalLoginModal');
                        var modal = bootstrap.Modal.getInstance(modalElement);
                        if (modal) modal.hide();

                        // Redirect atau muat ulang halaman setelah berhasil login
                        window.location.href = response.redirectUrl;
                    } else {
                        // Jika password salah atau user belum set password (PendingPassword)
                        $('#globalLoginModalContent').html(response);

                        if ($.validator && $.validator.unobtrusive) {
                            $.validator.unobtrusive.parse('#formLoginModal');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Login Error:', error);
                    alert('Terjadi kesalahan sistem saat mencoba masuk.');
                }
            });
        }
        // 3. Fungsi transisi cepat dari modal Login ke Register
        function switchToRegisterModal() {
            var loginModalEl = document.getElementById('globalLoginModal');
            var loginModal = bootstrap.Modal.getInstance(loginModalEl);
            if (loginModal) loginModal.hide();

            // Buka modal register publik
            openRegisterModal(false);
        }
                function openGlobalProfileModal() {
            $.get('/Account/ProfilePartial', function (data) {
                $('#globalProfileModalContent').html(data);

                if ($.validator && $.validator.unobtrusive) {
                    $.validator.unobtrusive.parse('#formProfileModal');
                }

                var profileModal = new bootstrap.Modal(document.getElementById('globalProfileModal'));
                profileModal.show();
            }).fail(function () {
                alert('Gagal memuat data profil.');
            });
        }

        // 2. Submit Perubahan Profil via AJAX
        function submitProfileModal(event) {
            event.preventDefault();

            var $form = $('#formProfileModal');
            var formData = $form.serialize();

            $.ajax({
                type: 'POST',
                url: '/Account/Profile',
                data: formData,
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]', $form).val()
                },
                success: function (response) {
                    if (typeof response === 'object' && response.success) {
                        // Tampilkan pesan sukses sementara atau langsung tutup modal & reload
                        $('#profileAlertContainer').html('<div class="alert alert-success small py-2">Profil berhasil diperbarui!</div>');
                        setTimeout(function() {
                            var modalElement = document.getElementById('globalProfileModal');
                            var modal = bootstrap.Modal.getInstance(modalElement);
                            if (modal) modal.hide();
                            window.location.reload(); // Refresh halaman untuk memperbarui nama di Navbar
                        }, 1000);
                    } else {
                        // Kembalikan view dengan error validasi
                        $('#globalProfileModalContent').html(response);
                        if ($.validator && $.validator.unobtrusive) {
                            $.validator.unobtrusive.parse('#formProfileModal');
                        }
                    }
                },
                error: function () {
                    alert('Terjadi kesalahan saat menyimpan profil.');
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
