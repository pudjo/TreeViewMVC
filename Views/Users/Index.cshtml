@using Sekolah.DTO
@model IEnumerable<UserManagementDto>

@{
    ViewData["Title"] = "Manajemen Pengguna";
}

<div class="container-fluid px-4 py-3">
    <!-- Header & Baris Kontrol -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">Manajemen Pengguna</h4>
            <p class="text-muted small mb-0">Kelola data akun pengguna, status, dan hak akses.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary btn-sm px-3" onclick="openRegisterModal(true)">
                <i class="bi bi-plus-lg me-1"></i> Tambah User
            </button>
        </div>
    </div>

    <!-- Kotak Pencarian -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-2">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Cari nama atau email..." value="@Context.Request.Query["searchTerm"]">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Cari</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Grid / Tabel -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0 small">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-3 py-2">Nama Lengkap</th>
                            <th class="py-2">Email</th>
                            <th class="py-2">Alamat</th>
                            <th class="py-2">Role</th> <!-- Kolom Role Ditambahkan -->
                            <th class="py-2">Status</th>
                            <th class="py-2">Terdaftar</th>
                            <th class="text-end pe-3 py-2">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrEmpty(user.Address) ? "-" : user.Address)</td>
                                    <td>
                                        @if (user.Role.Contains("Admin"))
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">@user.Role</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">@user.Role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.Status == "Active")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Aktif</span>
                                        }
                                        else if (user.Status == "PendingPassword")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">Pending Password</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">@user.Status</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt</td>
                                    <td class="text-end pe-3">
                                        <button type="button" class="btn btn-outline-info btn-sm px-2 py-0" onclick="viewUserDetail('@user.Id')">
                                            <i class="bi bi-info-circle"></i> Detail
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm px-2 py-0 ms-1" onclick="deleteUser('@user.Id')">
                                            <i class="bi bi-trash"></i> Hapus
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-4 d-block mb-1"></i> Belum ada data pengguna.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewUserDetail(userId) {
            alert('Fitur detail untuk User ID: ' + userId);
        }

        function deleteUser(userId) {
            if (confirm('Apakah Anda yakin ingin menghapus pengguna ini?')) {
                $.post('/Users/Delete', { id: userId }, function(response) {
                    window.location.reload();
                }).fail(function() {
                    alert('Gagal menghapus pengguna.');
                });
            }
        }
    </script>
}