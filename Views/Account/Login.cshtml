@using Sekolah.DTO
@using Sekolah.DTO
@model LoginDto

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title" id="globalLoginModalLabel">
        <i class="bi bi-box-arrow-in-right me-2"></i> Masuk ke Akun
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="formLoginModal" onsubmit="submitLoginModal(event)">
    @Html.AntiForgeryToken()

    <div class="modal-body p-4">
        <!-- Tempat menampilkan error jika email/password salah -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold small">Alamat Email</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="nama@domain.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold small">Kata Sandi</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
            <label asp-for="RememberMe" class="form-check-label small text-secondary">Ingat Saya</label>
        </div>
    </div>

    <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
        <span class="small text-muted">
            Belum punya akun? <a href="javascript:void(0);" onclick="switchToRegisterModal()" class="text-decoration-none fw-semibold">Daftar</a>
        </span>
        <div>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
            <button type="submit" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Masuk
            </button>
        </div>
    </div>
</form>